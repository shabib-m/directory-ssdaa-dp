msgstr ""
"إنّ حذف (@entity-type) سيؤدي إلى أن تعود "
"المخرجات التي لا تزال تطلب استخدامه "
"لإعدادات العرض الافتراضية."
msgid "Saved the %label @entity-type."
msgstr "تم حفظ %label @entity-type."
