msgstr "@group (بيانات تاريخيّة)"
msgid "User limit"
msgstr "حدود المستخدم"
msgid "Use path alias"
msgstr "استخدام الاسم المستعار للمسار"
msgid "Cooking time"
msgstr "وقت الطهي"
msgid "View any unpublished content"
msgstr "عرض أي محتوى غير منشور"
msgid "Relative default value"
