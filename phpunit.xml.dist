<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHPUnit configuration for running the site's PHPUnit Unit tests.

  Install the test tooling first (as a dev dependency):
    composer require drupal/core-dev:^9.4 phpspec/prophecy-phpunit:^2 [dev]

  Then run the unit tests with:
    vendor/bin/phpunit -c phpunit.xml.dist
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests-bootstrap.php"
         colors="true"
         beStrictAboutTestsThatDoNotTestAnything="true"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutChangesToGlobalState="true"
         printerClass="\Drupal\Tests\Listeners\HtmlOutputPrinter">
  <php>
    <ini name="error_reporting" value="32767"/>
    <ini name="memory_limit" value="-1"/>
    <env name="SYMFONY_DEPRECATIONS_HELPER" value="weak"/>
  </php>
  <testsuites>
    <testsuite name="unit">
      <directory>modules/*/tests/src/Unit</directory>
    </testsuite>
  </testsuites>
  <listeners>
    <listener class="\Drupal\Tests\Listeners\DrupalListener"/>
  </listeners>
</phpunit>
